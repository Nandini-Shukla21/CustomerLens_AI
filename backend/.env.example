# LLM
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5

# Uploads
UPLOAD_DIR=uploads

# Vector Store
VECTOR_STORE_PATH=vector_store/faiss_index

# Database
DATABASE_URL=sqlite:///./customer_ai.db

# Application
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000